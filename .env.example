# =============================================================================
# My Test DMV — environment template
# Copy:  cp .env.example .env
# Defaults below are for local Docker:  docker compose --profile local up -d
# For production (host nginx), swap in the PRODUCTION block at the bottom.
# =============================================================================

# --- Django ---
SECRET_KEY=your-secret-key-here-change-in-production
# Local HTTP compose: True. Production HTTPS: False.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,api,nginx,mytestdmv.com,api.mytestdmv.com

# --- PostgreSQL (compose overrides DB_HOST=db) ---
DB_NAME=dmv_db
DB_USER=dmv_user
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

# --- Email ---
# DEBUG=True → console backend unless EMAIL_BACKEND is set.
EMAIL_BACKEND=
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=your-email@gmail.com
EMAIL_TIMEOUT=10

# --- Google OAuth (backend + Next build arg fallback) ---
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# --- Apple Sign In ---
APPLE_CLIENT_ID=com.yourdomain.yourapp.signin
APPLE_BUNDLE_ID=com.yourdomain.yourapp
APPLE_TEAM_ID=YOUR_TEAM_ID
APPLE_KEY_ID=YOUR_KEY_ID
# Compose always mounts secrets/apple_auth_key.p8 → /run/secrets/apple_auth_key.p8
APPLE_PRIVATE_KEY_PATH=/run/secrets/apple_auth_key.p8
NEXT_PUBLIC_APPLE_CLIENT_ID=com.yourdomain.yourapp.signin

# --- JWT (minutes / days) ---
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=7

# --- CORS / CSRF ---
# Do not use "*": browsers reject credentialed CORS with wildcard origins.
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000,https://mytestdmv.com,https://www.mytestdmv.com
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,https://mytestdmv.com,https://www.mytestdmv.com,https://api.mytestdmv.com

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_TRIAL_PERIOD_DAYS=3

# --- Apple IAP ---
APPLE_IAP_BUNDLE_ID=com.yourdomain.yourapp
APPLE_IAP_PRODUCT_STARTER=com.mytestdmv.starter
APPLE_IAP_PRODUCT_STANDARD=com.mytestdmv.standard
APPLE_IAP_PRODUCT_PREMIUM=com.mytestdmv.premium
NEXT_PUBLIC_IAP_PRODUCT_STARTER=com.mytestdmv.starter
NEXT_PUBLIC_IAP_PRODUCT_STANDARD=com.mytestdmv.standard
NEXT_PUBLIC_IAP_PRODUCT_PREMIUM=com.mytestdmv.premium

# --- Wagtail ---
WAGTAILADMIN_BASE_URL=http://localhost/cms

# --- Next.js / Docker (local profile) ---
NEXT_PUBLIC_APP_DOMAIN=http://localhost
NEXT_PUBLIC_API_URL=http://localhost/api
# Server-side BFF → api container
API_URL=http://api:8000/api
# Optional; defaults to NEXT_PUBLIC_API_URL origin for absolute media Host headers
MEDIA_PUBLIC_ORIGIN=
# next/image optimizer fetches CMS images on the Docker network (build-time)
MEDIA_INTERNAL_ORIGIN=http://api:8000
NEXT_PUBLIC_MEDIA_OPTIMIZE_ORIGIN=http://api:8000
# false on plain HTTP; true behind HTTPS
COOKIE_SECURE=false

# Host paths bind-mounted into api (and local nginx /media)
MEDIA_HOST_PATH=./data/media
STATIC_HOST_PATH=./data/staticfiles

# Published on loopback for host nginx (also used with --profile local)
API_BIND=127.0.0.1:8000
WEB_BIND=127.0.0.1:3000
HTTP_PORT=80

GUNICORN_WORKERS=3
GUNICORN_THREADS=2

# --- Azure Speech (Next.js /api/tts) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# Containers: keep False (logs go to stdout)
LOG_TO_FILE=False

# =============================================================================
# PRODUCTION (host nginx → 127.0.0.1:3000 / :8000)
# Uncomment / replace the matching keys above when deploying the VPS.
# =============================================================================
# DEBUG=False
# NEXT_PUBLIC_APP_DOMAIN=https://mytestdmv.com
# NEXT_PUBLIC_API_URL=https://api.mytestdmv.com/api
# MEDIA_PUBLIC_ORIGIN=https://api.mytestdmv.com
# COOKIE_SECURE=true
# WAGTAILADMIN_BASE_URL=https://api.mytestdmv.com
# CORS_ALLOWED_ORIGINS=https://mytestdmv.com,https://www.mytestdmv.com
# CSRF_TRUSTED_ORIGINS=https://mytestdmv.com,https://www.mytestdmv.com,https://api.mytestdmv.com
# MEDIA_HOST_PATH=/home/dmv/apps/dmv/media
# STATIC_HOST_PATH=/home/dmv/apps/dmv/staticfiles
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
